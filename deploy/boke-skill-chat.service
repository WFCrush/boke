[Unit]
Description=Boke Public Skill Chat API
After=network.target

[Service]
Type=simple
User=boke
Group=boke
WorkingDirectory=/opt/boke/repo
EnvironmentFile=/etc/boke/skill-chat.env
ExecStart=/usr/bin/node server/public-skill-chat-api.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/var/lib/boke/public-skill-chat

[Install]
WantedBy=multi-user.target
