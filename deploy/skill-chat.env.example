# Copy to /etc/boke/skill-chat.env on the server and set mode 600.
NODE_ENV=production
SKILL_CHAT_HOST=127.0.0.1
SKILL_CHAT_PORT=5050
PUBLIC_SKILL_CHAT_ROUTE_PREFIX=/boke/api/public-skill-chat
PUBLIC_SKILL_CHAT_DIR=/var/lib/boke/public-skill-chat/sessions
PUBLIC_SKILL_CHAT_RATE_LIMIT=60

SKILL_CHAT_BASE_URL=https://api.openai.com/v1
SKILL_CHAT_MODEL=
SKILL_CHAT_API_KEY=
SKILL_CHAT_SKILL=xie-xiao-shu
SKILL_CHAT_SKILL_DIR=/opt/boke/skills/xie-xiao-shu
SKILL_CHAT_SECRET_SALT=
SKILL_CHAT_REQUEST_TIMEOUT_MS=120000
SKILL_CHAT_MAX_MESSAGE_CHARS=8000
SKILL_CHAT_MAX_CONVERSATION_CHARS=60000
SKILL_CHAT_MAX_MATERIAL_CHARS=140000
